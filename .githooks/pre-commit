#!/bin/bash
# ─────────────────────────────────────────────────────────────────────────────
# pre-commit — blocks staged credentials before a commit exists.
#
# Installed by scripts/install_hooks.sh into .git/hooks/pre-commit.
# Bypass for one commit only:  git commit --no-verify
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$ROOT" || exit 0

SCANNER="$ROOT/scripts/check_secrets.py"
if [ ! -f "$SCANNER" ]; then
    echo "pre-commit: scripts/check_secrets.py missing; skipping secret scan" >&2
    exit 0
fi

PY="$(command -v python3 || true)"
if [ -z "$PY" ]; then
    echo "pre-commit: python3 not found; skipping secret scan" >&2
    exit 0
fi

echo "pre-commit: scanning staged content for credentials…"
if ! "$PY" "$SCANNER" --staged; then
    cat >&2 <<'MSG'

Commit blocked: staged content contains a credential.

  1. Remove the secret from the file.
  2. If it is a deliberate non-secret, append `secret-scan: allow` to that line.
  3. Re-stage and commit again.

To bypass once (not recommended): git commit --no-verify
MSG
    exit 1
fi

# Syntax gates, so a broken file never reaches a commit.
if ! "$PY" -m py_compile app.py 2>/dev/null; then
    echo "pre-commit: app.py does not compile" >&2
    exit 1
fi
rm -rf "$ROOT/__pycache__" 2>/dev/null

if command -v node >/dev/null 2>&1; then
    if ! node --check ui/app.js 2>/dev/null; then
        echo "pre-commit: ui/app.js has a syntax error" >&2
        exit 1
    fi
fi

exit 0
